# Lead email delivery (Resend) — set these in Vercel → Project → Settings → Environment Variables.
# For local dev, copy this file to .env.local and fill in real values (.env.local is gitignored).

# Your Resend API key — create at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# The "From" address. Until your domain is verified in Resend you MUST use the
# sandbox sender below (it only delivers to the Resend account owner's email):
#   RESEND_FROM=Caffeine Nirvana <onboarding@resend.dev>
# After verifying caffeinenirvana.co in Resend (add the DNS records it gives you),
# switch to your own domain:
RESEND_FROM=Caffeine Nirvana <leads@caffeinenirvana.co>
